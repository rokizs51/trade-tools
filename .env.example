# Copy this file to .env and replace the placeholder with your OpenRouter key.
# Never commit the populated .env file.
OPENROUTER_API_KEY=

# Optional Buyer Finder model and search overrides.
BUYER_PLANNER_MODEL=google/gemini-3.5-flash-lite
BUYER_RESEARCH_MODEL=openai/gpt-4.1-mini
BUYER_FORMATTER_MODEL=openai/gpt-4.1-mini
BUYER_VERIFIER_MODEL=openai/gpt-4.1-mini
BUYER_SEARCH_MAX_QUERIES=3
BUYER_SEARCH_MAX_RESULTS=5
BUYER_SEARCH_MAX_RAW_CANDIDATES=25
BUYER_VERIFICATION_CONCURRENCY=3
BUYER_SEARCH_MAX_RETRIES=2
BUYER_SEARCH_RETRY_BASE_MS=500
BUYER_SEARCH_TIMEOUT_MS=120000
# Set after evaluation establishes an acceptable per-run budget. Leave blank to disable.
BUYER_SEARCH_MAX_COST_USD=
