# Copy this file to .env and replace the placeholder with your OpenRouter key.
# Never commit the populated .env file.
OPENROUTER_API_KEY=

# Supabase Postgres is the only supported persistence provider.
# Copy the connection URI from the dashboard Connect panel. Never use production credentials locally.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Use session for a long-lived server. Use transaction for serverless/port 6543.
DATABASE_POOL_MODE=session
DATABASE_MAX_CONNECTIONS=5
# Keep a session-pooler connection warm to avoid paying the remote TLS handshake after short idle periods.
DATABASE_IDLE_TIMEOUT_SECONDS=300

# Authentication is required in every supported environment.
# In Supabase, disable public sign-ups and invite internal users from Authentication > Users.
AUTH_MODE=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional Buyer Finder model and search overrides.
BUYER_PLANNER_MODEL=google/gemini-3.5-flash-lite
BUYER_RESEARCH_MODEL=openai/gpt-4.1-mini
BUYER_FORMATTER_MODEL=openai/gpt-4.1-mini
BUYER_VERIFIER_MODEL=openai/gpt-4.1-mini
# Applied only to OpenAI GPT-5-family Buyer Finder stages. "low" prevents reasoning
# tokens from exhausting small structured-output stages such as planning and verification.
BUYER_GPT5_REASONING_EFFORT=low
BUYER_SEARCH_MAX_QUERIES=3
BUYER_SEARCH_MAX_RESULTS=5
BUYER_SEARCH_MAX_RAW_CANDIDATES=25
BUYER_SEARCH_MAX_QUEUED=10
BUYER_VERIFICATION_CONCURRENCY=3
BUYER_SEARCH_MAX_RETRIES=2
BUYER_SEARCH_RETRY_BASE_MS=500
BUYER_SEARCH_TIMEOUT_MS=120000
# One bounded evidence-recovery pass when the strict search returns too few qualified candidates.
BUYER_FALLBACK_ENABLED=true
BUYER_FALLBACK_MIN_QUALIFIED=3
BUYER_FALLBACK_MAX_SEARCH_CALLS=2
BUYER_FALLBACK_MAX_CANDIDATES=10
# Set after evaluation establishes an acceptable per-run budget. Leave blank to disable.
BUYER_SEARCH_MAX_COST_USD=

# Optional Milestone 6 comparison configuration. At least one candidate model must differ from the
# baseline BUYER_* models before `npm run buyer:eval -- --confirm-live` will make paid requests.
# BUYER_EVAL_CANDIDATE_PLANNER_MODEL=
# BUYER_EVAL_CANDIDATE_RESEARCH_MODEL=
# BUYER_EVAL_CANDIDATE_FORMATTER_MODEL=
# BUYER_EVAL_CANDIDATE_VERIFIER_MODEL=
# BUYER_EVAL_FIXTURES=all
# BUYER_EVAL_MAX_RUNS=24
# BUYER_EVAL_OUTPUT=data/buyer-evaluations/evaluation.json
